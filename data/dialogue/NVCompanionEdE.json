   "id": "EDELog2",
   "section": "topics",
   "responses": [
    {
     "text": "Download Complete. Begin Recording.",
     "emotion": "neutral",
     "intensity": 50
    },
    {
     "text": "Navarro outpost scientists, I am glad that ED-E has reached you. You will find several databanks of information on this machine.",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "prompt": "&lt;Log 2 Playback::Begin>"
