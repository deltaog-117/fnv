   "section": "topics",
   "responses": [
    {
     "text": "Subject E: Diagnosis complete. Begin Recording.",
     "emotion": "neutral",
     "intensity": 50
    },
    {
     "text": "My name is Whitley. I'm a researcher at Adams Air Force base. Until recently I was in charge of the Duraframe reinforcement project for the combat model Eyebots.",
     "emotion": "neutral",
     "intensity": 50
    }
