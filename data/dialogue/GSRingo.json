    }
   ],
   "prompt": "Who's in charge here?"
  },
  {
   "id": "VDialogueCrimsonCaravanGSRingoTopic002",
   "section": "topics",
   "responses": [
    {
     "text": "I'm getting ready to run a caravan up towards Utah. There's a town called New Canaan which is supposed to be pretty prosperous.",
     "emotion": "neutral",
     "intensity": 50
    },
    {
     "text": "The Crimson Caravan doesn't have any branches out that way, so it'll be up to me get to things started.",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "prompt": "So what's next for you?"
  },
