   "key": "vfreeformgoodspringsgsjoecobbtopic022",
   "section": "topics",
   "responses": [
    {
     "text": "It's about time. I saw some of the townies gathering at the saloon, so we've got a militia to take down. We get rid of them and we own this place.",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "topic": "VFreeformGoodspringsGSJoeCobbTopic022",
   "prompt": "I've done all I can. Let's take over Goodsprings."
