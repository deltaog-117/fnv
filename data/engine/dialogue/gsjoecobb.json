   "key": "vfreeformgoodspringsgsjoecobbtopic025",
   "section": "topics",
   "responses": [
    {
     "text": "I figure we'll hang around Goodsprings for awhile, maybe get some of the other gangs to join up with us.",
     "emotion": "neutral",
     "intensity": 50
