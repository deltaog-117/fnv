   ],
   "topic": "VMS29aVFSVanGraffThug09Topic000",
   "prompt": "That's right."
  },
  {
   "key": "vms29avfsvangraffthug09topic001",
   "section": "topics",
   "responses": [
    {
     "text": "You can always tell a rookie. You look too eager. Give the job a few hours, and the shine'll come right off.",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "topic": "VMS29aVFSVanGraffThug09Topic001",
   "prompt": "How did you know?"
  },
  {
   "key": "vms29avfsvangraffthug09topic002",
   "section": "topics",
   "responses": [
    {
     "text": "I've been paired with worse, I guess. Anyway, let's see if you can follow instructions.",
