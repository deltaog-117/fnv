   "section": "topics",
   "responses": [
    {
     "text": "Well, no time for pleasantries. I've got your gear right here, but let's see if you can follow instructions.",
     "emotion": "neutral",
     "intensity": 50
    },
    {
     "text": "You'll be covering the other side of the door there. Take your position while I get your stuff out.",
