  {
   "key": "vms29avfsvangraffthug09topic005",
   "section": "topics",
   "responses": [
    {
     "text": "Lasers have a high rate of fire, but not a lot of stopping power. Plasma on the other hand is slow as a mule, but with a kick to match.",
     "emotion": "neutral",
     "intensity": 50
    },
    {
     "text": "So what'll it be?",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
