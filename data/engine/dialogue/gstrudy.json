  {
   "key": "vfreeformgoodspringsgstrudytopic030_2",
   "section": "topics",
   "responses": [
    {
     "text": "[FAILED] No thank you. Good luck with your, uh, \"ambush.\"",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "topic": "VFreeformGoodspringsGSTrudyTopic030",
