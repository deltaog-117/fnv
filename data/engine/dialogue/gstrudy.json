   "section": "topics",
   "responses": [
    {
     "text": "[FAILED] All the more reason for me to sit this one out. I'll be rooting for you, though.",
     "emotion": "neutral",
     "intensity": 50
    }
   ],
   "topic": "VFreeformGoodspringsGSTrudyTopic001",
   "prompt": "Uh, we're a little outnumbered against the powder gang. Think you could help?",
   "label": "< Speech 25 >",
   "conditions": [
    {
