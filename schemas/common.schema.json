{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "form_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "dlc": {
      "enum": [
        "base",
        "dead_money",
        "honest_hearts",
        "old_world_blues",
        "lonesome_road",
        "gun_runners_arsenal"
      ]
    },
    "skill": {
      "enum": [
        "barter",
        "energy_weapons",
        "explosives",
        "guns",
        "lockpick",
        "medicine",
        "melee_weapons",
        "repair",
        "science",
        "sneak",
        "speech",
        "survival",
        "unarmed"
      ]
    },
    "special": {
      "enum": [
        "strength",
        "perception",
        "endurance",
        "charisma",
        "intelligence",
        "agility",
        "luck"
      ]
    },
    "modifier": {
      "description": "A change a perk or trait makes to the numbers the character derives. Amounts are per rank.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "skill_points_per_level"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "xp_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "pounds"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "carry_weight"
            },
            "pounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "max_hp"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "action_points"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "all_skills"
            },
            "amount": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "skill",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "skill"
            },
            "skill": {
              "$ref": "#/$defs/skill"
            },
            "amount": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "damage_threshold"
            },
            "amount": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "damage_resistance"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ignore_threshold"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "damage_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "skill": {
              "$ref": "#/$defs/skill"
            },
            "foe": {
              "$ref": "#/$defs/foe_kind"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "crit_chance"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "skill": {
              "$ref": "#/$defs/skill"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "crit_damage_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "skill": {
              "$ref": "#/$defs/skill"
            },
            "foe": {
              "$ref": "#/$defs/foe_kind"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ap_cost_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "skill": {
              "$ref": "#/$defs/skill"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reload_ap_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "spread_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "skill": {
              "$ref": "#/$defs/skill"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "weapon_wear_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heal_percent"
            },
            "percent": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            },
            "item": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "faction": {
      "$ref": "#/$defs/id",
      "description": "Faction id from data/engine/factions.json (towns included, since they have reputation too)."
    },
    "condition": {
      "description": "A predicate over game state. Used by quest rules, dialogue and NPC availability.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "all",
                "any"
              ]
            },
            "of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "not"
            },
            "of": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "quest",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "quest"
            },
            "quest": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "enum": [
                "not_started",
                "active",
                "completed",
                "failed",
                "stage_at_least",
                "stage_is"
              ]
            },
            "stage": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "stage_at_least",
                      "stage_is"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "stage"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "stage"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "level": {
              "enum": [
                "vilified",
                "shunned",
                "mixed",
                "neutral",
                "accepted",
                "liked",
                "idolized"
              ]
            },
            "op": {
              "enum": [
                "at_least",
                "at_most",
                "is"
              ],
              "default": "at_least"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "renown",
            "tier"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation_tier"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "renown": {
              "enum": [
                "fame",
                "infamy"
              ]
            },
            "tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "op": {
              "enum": [
                "at_least",
                "at_most",
                "is"
              ],
              "default": "at_least"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "renown",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation_points"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "renown": {
              "enum": [
                "fame",
                "infamy"
              ]
            },
            "min": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "skill",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "skill"
            },
            "skill": {
              "$ref": "#/$defs/skill"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stat",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "special"
            },
            "stat": {
              "$ref": "#/$defs/special"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "percent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "health"
            },
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "op": {
              "enum": [
                "at_least",
                "at_most",
                "is"
              ],
              "default": "at_least"
            }
          }
        },
        {
          "type": "object",
          "description": "The player has absorbed at least this many rads.",
          "required": [
            "type",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "radiation"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          }
        },
        {
          "type": "object",
          "description": "The player is addicted to at least one chem.",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "addicted"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "perk"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "perk"
            },
            "perk": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "alignment"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "karma"
            },
            "alignment": {
              "enum": [
                "good",
                "neutral",
                "evil"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "companion",
            "active"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "companion"
            },
            "companion": {
              "$ref": "#/$defs/id"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "has_item"
            },
            "item": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "equipped"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "wearing"
            },
            "equipped": {
              "$ref": "#/$defs/id"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "flag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "npc",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "npc"
            },
            "npc": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "enum": [
                "alive",
                "dead",
                "hostile",
                "met"
              ]
            }
          }
        }
      ]
    },
    "effect": {
      "description": "A change to game state. Used by quest rules and dialogue choices.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "quest"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "start_quest",
                "complete_quest",
                "fail_quest",
                "block_quest"
              ]
            },
            "quest": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "quest",
            "stage"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_stage"
            },
            "quest": {
              "$ref": "#/$defs/id"
            },
            "stage": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "fame",
            "infamy"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "fame": {
              "type": "number"
            },
            "infamy": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "level": {
              "enum": [
                "vilified",
                "shunned",
                "mixed",
                "neutral",
                "accepted",
                "liked",
                "idolized"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "karma",
                "xp",
                "caps"
              ]
            },
            "amount": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "give_item",
                "take_item"
              ]
            },
            "item": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_flag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "companion"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "companion_join",
                "companion_leave"
              ]
            },
            "companion": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "npc"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "kill_npc",
                "set_hostile",
                "set_friendly",
                "remove_npc"
              ]
            },
            "npc": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "ending"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "unlock_ending",
                "lock_ending"
              ]
            },
            "ending": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heal"
            }
          }
        },
        {
          "type": "object",
          "description": "Cures radiation (to none) or every addiction.",
          "required": [
            "type",
            "ailment"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cure"
            },
            "ailment": {
              "enum": [
                "radiation",
                "addiction"
              ]
            }
          }
        }
      ]
    },
    "foe_kind": {
      "enum": [
        "human",
        "robot",
        "animal",
        "mutated_animal",
        "mutated_insect",
        "super_mutant",
        "abomination"
      ]
    }
  }
}
