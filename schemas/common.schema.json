{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "form_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "dlc": {
      "enum": [
        "base",
        "dead_money",
        "honest_hearts",
        "old_world_blues",
        "lonesome_road",
        "gun_runners_arsenal"
      ]
    },
    "skill": {
      "enum": [
        "barter",
        "energy_weapons",
        "explosives",
        "guns",
        "lockpick",
        "medicine",
        "melee_weapons",
        "repair",
        "science",
        "sneak",
        "speech",
        "survival",
        "unarmed"
      ]
    },
    "special": {
      "enum": [
        "strength",
        "perception",
        "endurance",
        "charisma",
        "intelligence",
        "agility",
        "luck"
      ]
    },
    "faction": {
      "$ref": "#/$defs/id",
      "description": "Faction id from data/engine/factions.json (towns included, since they have reputation too)."
    },
    "condition": {
      "description": "A predicate over game state. Used by quest rules, dialogue and NPC availability.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "all",
                "any"
              ]
            },
            "of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "not"
            },
            "of": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "quest",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "quest"
            },
            "quest": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "enum": [
                "not_started",
                "active",
                "completed",
                "failed",
                "stage_at_least",
                "stage_is"
              ]
            },
            "stage": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "level": {
              "enum": [
                "vilified",
                "shunned",
                "mixed",
                "neutral",
                "accepted",
                "liked",
                "idolized"
              ]
            },
            "op": {
              "enum": [
                "at_least",
                "at_most",
                "is"
              ],
              "default": "at_least"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "skill",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "skill"
            },
            "skill": {
              "$ref": "#/$defs/skill"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stat",
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "special"
            },
            "stat": {
              "$ref": "#/$defs/special"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "perk"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "perk"
            },
            "perk": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "alignment"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "karma"
            },
            "alignment": {
              "enum": [
                "good",
                "neutral",
                "evil"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "companion",
            "active"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "companion"
            },
            "companion": {
              "$ref": "#/$defs/id"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "has_item"
            },
            "item": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "equipped"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "wearing"
            },
            "equipped": {
              "$ref": "#/$defs/id"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "flag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "npc",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "npc"
            },
            "npc": {
              "$ref": "#/$defs/id"
            },
            "state": {
              "enum": [
                "alive",
                "dead",
                "hostile",
                "met"
              ]
            }
          }
        }
      ]
    },
    "effect": {
      "description": "A change to game state. Used by quest rules and dialogue choices.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "quest"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "start_quest",
                "complete_quest",
                "fail_quest",
                "block_quest"
              ]
            },
            "quest": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "quest",
            "stage"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_stage"
            },
            "quest": {
              "$ref": "#/$defs/id"
            },
            "stage": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "fame",
            "infamy"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "fame": {
              "type": "number"
            },
            "infamy": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "faction",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_reputation"
            },
            "faction": {
              "$ref": "#/$defs/faction"
            },
            "level": {
              "enum": [
                "vilified",
                "shunned",
                "mixed",
                "neutral",
                "accepted",
                "liked",
                "idolized"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "karma",
                "xp",
                "caps"
              ]
            },
            "amount": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "give_item",
                "take_item"
              ]
            },
            "item": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "set_flag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "companion"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "companion_join",
                "companion_leave"
              ]
            },
            "companion": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "npc"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "kill_npc",
                "set_hostile",
                "set_friendly",
                "remove_npc"
              ]
            },
            "npc": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "ending"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "unlock_ending",
                "lock_ending"
              ]
            },
            "ending": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    }
  }
}
