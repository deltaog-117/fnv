{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "find.schema.json",
  "title": "Find",
  "description": "One entry in data/engine/finds.json: items the player can pick up once at a place.",
  "type": "object",
  "required": [
    "id",
    "name",
    "place",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "place": {
      "description": "Location id where the items lie.",
      "$ref": "common.schema.json#/$defs/id"
    },
    "items": {
      "description": "What the player takes; an item appears once.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
