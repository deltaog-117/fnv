#!/usr/bin/env bash
# Project check: the data pipeline, then Rust. Silent on success; on failure it
# prints only the failing step's output. CHECK_ALL=1 forces the data steps.
set -uo pipefail
cd "$(dirname "$0")/.."

PY="${PYTHON:-.venv/bin/python}"
[ -x "$PY" ] || PY=python3

fail() {
    printf 'check failed: %s\n%s\n' "$1" "$2" >&2
    exit 1
}

run() {
    local name=$1
    shift
    local out
    out=$("$@" 2>&1) || fail "$name" "$out"
}

# The data steps take about eight seconds, so they run only when data, schemas or
# scripts differ from the last commit (everything counts until the first commit).
if [ "${CHECK_ALL:-0}" = 1 ] || [ -n "$(git status --porcelain -- data schemas scripts 2>/dev/null)" ]; then
    run "python needs jsonschema (python3 -m venv .venv && .venv/bin/pip install jsonschema)" \
        "$PY" -c "import jsonschema, referencing"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    cp -r data "$tmp/data"
    run "normalize.py" "$PY" -I scripts/normalize.py "$tmp/data"
    run "data/engine is stale; run: python3 -I scripts/normalize.py data" \
        diff -rq data/engine "$tmp/data/engine"
    run "validate.py" "$PY" -I scripts/validate.py .
fi

run "cargo fmt" cargo fmt --all -- --check
run "cargo clippy" cargo clippy --workspace --all-targets --quiet -- -D warnings
run "cargo test" cargo test --workspace --quiet
